<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Overrides Leanback's own defaults (8dp/8dp) - too tight, reads as cluttered with cards
         this size. Also gives the focus-scale pop room to grow without clipping into neighbors.
         Deliberately overriding a Leanback-private resource, not an unused/dead one - lint can't
         see that Leanback's own internal layouts reference these by name, only that nothing in
         this app's own code does. tools:override documents that instead of silencing it blind. -->
    <dimen name="lb_browse_item_horizontal_spacing" tools:override="true">28dp</dimen>
    <dimen name="lb_browse_item_vertical_spacing" tools:override="true">28dp</dimen>
</resources>
