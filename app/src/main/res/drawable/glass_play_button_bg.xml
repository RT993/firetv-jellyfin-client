<?xml version="1.0" encoding="utf-8"?>
<!-- A solid white circle with a soft radial-gradient halo bleeding into the extra space around
     it (the view itself is sized larger than the circle - see btn_play_pause in
     activity_playback.xml) - the flat-gradient approximation of the design's real box-shadow
     blur glow, same "no real-time blur on this hardware" tradeoff as glass_panel_bg. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="44dp"
                android:centerColor="#4DFFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item
        android:width="60dp"
        android:height="60dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</layer-list>
