<?xml version="1.0" encoding="utf-8"?>
<!-- A solid thumb with a soft translucent ring around it - the view is sized larger than the
     inner dot (see the thumb View in activity_playback.xml) so the ring has room to show. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#33FFFFFF" />
        </shape>
    </item>
    <item
        android:width="8dp"
        android:height="8dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</layer-list>
