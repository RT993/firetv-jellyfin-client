<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <ImageView
        android:id="@+id/hero_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/hero_gradient_scrim" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="200dp"
        android:layout_marginBottom="36dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hero_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            tools:text="Action / Thriller  •  2021  •  1h 48m" />

        <TextView
            android:id="@+id/hero_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_primary"
            android:textSize="34sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Shadow Hunter" />

        <TextView
            android:id="@+id/hero_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="A relentless detective unravels a web of secrets as he hunts a mysterious assassin lurking in the shadows." />

        <TextView
            android:id="@+id/hero_watch_now"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/hero_watch_button_bg"
            android:paddingStart="24dp"
            android:paddingEnd="28dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/hero_watch_now"
            android:textColor="@color/background_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            android:drawablePadding="10dp"
            android:drawableStart="@drawable/ic_play_triangle" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/hero_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="28dp"
        android:orientation="horizontal"
        android:gravity="center_vertical" />

</merge>
