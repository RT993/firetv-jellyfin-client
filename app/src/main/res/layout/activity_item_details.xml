<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
         Loaded and scaled ourselves (centerCrop) instead of via Leanback's
         DetailsSupportFragmentBackgroundController, whose FitWidthBitmapDrawable only scales to
         fit the screen's width and derives height from the bitmap's own aspect ratio - it doesn't
         crop to fill, so a backdrop proportionally wider than the screen left a solid-color gap
         at the bottom instead of image. centerCrop guarantees full-screen coverage regardless of
         the source image's aspect ratio.
    -->
    <ImageView
        android:id="@+id/details_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_dark"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/item_details_fragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
