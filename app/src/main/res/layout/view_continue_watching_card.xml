<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/cw_thumb_frame"
        android:layout_width="240dp"
        android:layout_height="135dp">

        <ImageView
            android:id="@+id/cw_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/card_placeholder"
            android:contentDescription="@null" />

        <View
            android:id="@+id/cw_progress_track"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="bottom"
            android:background="#4DFFFFFF" />

        <View
            android:id="@+id/cw_progress_fill"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_gravity="bottom|start"
            android:background="@color/jellyfin_purple"
            tools:layout_width="120dp" />

    </FrameLayout>

    <TextView
        android:id="@+id/cw_title"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        tools:text="The Lord of the Rings" />

    <TextView
        android:id="@+id/cw_subtitle"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        tools:text="S1 E5" />

</LinearLayout>
