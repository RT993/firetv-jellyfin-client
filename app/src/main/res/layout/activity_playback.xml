<?xml version="1.0" encoding="utf-8"?>
<!-- No background here - the theme's windowBackground is already black; painting it again here
     would just be overdraw for every frame of every video played. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.media3.ui.AspectRatioFrameLayout
        android:id="@+id/player_aspect_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">

        <SurfaceView
            android:id="@+id/player_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <androidx.media3.ui.SubtitleView
            android:id="@+id/player_subtitles"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.media3.ui.AspectRatioFrameLayout>

    <!-- "Glass Player" redesign: a floating frosted control card (scrubber + buttons) instead of
         the old full-width bar, with the title/subtitle sitting above it rather than inside it -
         both still live inside this one auto-hiding container, same as before. -->
    <LinearLayout
        android:id="@+id/playback_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:background="@drawable/hero_gradient_scrim"
        android:paddingStart="60dp"
        android:paddingEnd="60dp"
        android:paddingTop="80dp"
        android:paddingBottom="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.3"
            android:text="@string/playback_now_playing_label"
            android:textAllCaps="true"
            android:textColor="#99F4F6FB"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/playback_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/text_primary"
            android:textSize="48sp"
            android:textStyle="bold"
            tools:text="The Lord of the Rings" />

        <TextView
            android:id="@+id/playback_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="18sp"
            tools:text="Direct play" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/playback_position"
                    android:layout_width="55dp"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    tools:text="1:12" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="12dp"
                    android:layout_weight="1"
                    android:clipChildren="false"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp">

                    <View
                        android:id="@+id/playback_progress_track"
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/glass_track_bg" />

                    <FrameLayout
                        android:id="@+id/playback_progress_fill"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="start"
                        tools:layout_width="80dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:layout_gravity="center_vertical"
                            android:background="@drawable/glass_track_fill_bg" />

                        <View
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_gravity="end|center_vertical"
                            android:background="@drawable/glass_progress_thumb_bg" />

                    </FrameLayout>

                </FrameLayout>

                <TextView
                    android:id="@+id/playback_duration"
                    android:layout_width="55dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    tools:text="2:14:00" />

            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/btn_rewind"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:background="@drawable/glass_pill_button_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:stateListAnimator="@animator/scale_on_focus"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:contentDescription="@string/playback_rewind">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_playback_rewind" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:text="@string/playback_skip_amount_label"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btn_play_pause"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:layout_marginStart="24dp"
                        android:layout_marginEnd="24dp"
                        android:background="@drawable/glass_play_button_bg"
                        android:stateListAnimator="@animator/scale_on_focus"
                        android:padding="31dp"
                        android:scaleType="fitCenter"
                        android:tint="#07080B"
                        android:src="@drawable/ic_hero_play"
                        android:contentDescription="@string/playback_play" />

                    <LinearLayout
                        android:id="@+id/btn_forward"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:background="@drawable/glass_pill_button_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:stateListAnimator="@animator/scale_on_focus"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:contentDescription="@string/playback_forward">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/playback_skip_amount_label"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="7dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_playback_forward" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btn_next_episode"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/glass_circle_button_bg"
                        android:stateListAnimator="@animator/scale_on_focus"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_playback_next"
                        android:contentDescription="@string/playback_next_episode"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <ImageButton
                        android:id="@+id/btn_audio_track"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/glass_circle_button_bg"
                        android:stateListAnimator="@animator/scale_on_focus"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_playback_audio"
                        android:contentDescription="@string/playback_audio_track"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <ImageButton
                        android:id="@+id/btn_subtitle_track"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/glass_circle_button_bg"
                        android:stateListAnimator="@animator/scale_on_focus"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_playback_subtitles"
                        android:contentDescription="@string/playback_subtitle_track"
                        android:visibility="gone"
                        tools:visibility="visible" />

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Independent of playback_controls: visible purely off playback position (the tagged intro
         window / the last ~30s), so it still shows even while the main overlay has auto-hidden. -->
    <TextView
        android:id="@+id/btn_skip_intro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="60dp"
        android:layout_marginBottom="60dp"
        android:background="@drawable/glass_pill_button_bg"
        android:clickable="true"
        android:focusable="true"
        android:stateListAnimator="@animator/scale_on_focus"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:text="@string/playback_skip_intro"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Same position/behavior as btn_skip_intro, for the "Previously on..." recap segment - the
         two never show at once since a recap segment always precedes an intro segment in time. -->
    <TextView
        android:id="@+id/btn_skip_recap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="60dp"
        android:layout_marginBottom="60dp"
        android:background="@drawable/glass_pill_button_bg"
        android:clickable="true"
        android:focusable="true"
        android:stateListAnimator="@animator/scale_on_focus"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:text="@string/playback_skip_recap"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/up_next_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="60dp"
        android:layout_marginBottom="60dp"
        android:background="@drawable/glass_panel_bg"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/up_next_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="260dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            tools:text="Up Next: The Two Towers" />

        <TextView
            android:id="@+id/up_next_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="Playing in 10s" />

        <TextView
            android:id="@+id/btn_up_next_play"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/glass_pill_button_bg"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@animator/scale_on_focus"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/playback_play_now"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
