<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_background">

    <LinearLayout
        android:id="@+id/login_card"
        android:layout_width="460dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/login_card_bg"
        android:padding="40dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/ic_treehouse_logo"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="@string/app_logo"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:fontFamily="@font/royalty_criminals" />

        <TextView
            android:id="@+id/login_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="28dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="Connect to your Jellyfin server" />

        <!-- Step 1: server address -->
        <LinearLayout
            android:id="@+id/step_server"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/input_server_address"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/login_input_bg"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:imeOptions="actionNext"
                android:inputType="textUri"
                android:hint="@string/login_server_address_hint"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btn_continue"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/login_button_primary_bg"
                android:text="@string/login_continue"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Step 2: credentials -->
        <LinearLayout
            android:id="@+id/step_credentials"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/input_username"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/login_input_bg"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:hint="@string/login_username_title"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/input_password"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/login_input_bg"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:hint="@string/login_password_title"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btn_sign_in"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/login_button_primary_bg"
                android:text="@string/login_sign_in_title"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_quick_connect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/glass_button_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:text="@string/login_quick_connect_title"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- Step 3: quick connect -->
        <LinearLayout
            android:id="@+id/step_quick_connect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/quick_connect_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.3"
                android:textColor="@color/text_primary"
                android:textSize="36sp"
                android:textStyle="bold"
                tools:text="ABCD" />

            <TextView
                android:id="@+id/quick_connect_instructions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                tools:text="Enter code ABCD in another Jellyfin app or web page" />

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:indeterminate="true" />

        </LinearLayout>

        <TextView
            android:id="@+id/login_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/login_error"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Could not sign in. Check the server address and credentials."
            tools:visibility="visible" />

    </LinearLayout>

</FrameLayout>
