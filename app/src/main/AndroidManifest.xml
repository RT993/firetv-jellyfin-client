<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android TV apps must declare the leanback feature as required, and explicitly
         mark touchscreen as not required since Fire TV devices have no touchscreen. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".JellyfinTvApplication"
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.FireTvJellyfin"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic is enabled because many self-hosted Jellyfin servers on a
             local network are only reachable over plain http://. Tighten this with a
             network security config scoped to trusted hosts before any wider release. -->

        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.FireTvJellyfin">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.FireTvJellyfin" />

        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false"
            android:theme="@style/Theme.FireTvJellyfin" />

        <activity
            android:name=".ui.details.ItemDetailsActivity"
            android:exported="false"
            android:theme="@style/Theme.FireTvJellyfin" />

        <activity
            android:name=".ui.playback.PlaybackActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|uiMode"
            android:theme="@style/Theme.FireTvJellyfin.Playback" />

    </application>

</manifest>
